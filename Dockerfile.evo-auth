# Evo Auth - Production Dockerfile
FROM ruby:3.4.4-slim

WORKDIR /rails

ARG CACHEBUST=5

# Install system deps
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
    build-essential \
    libpq-dev \
    postgresql-client \
    imagemagick \
    git \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy source
COPY evo-auth-service-community/ /rails/

# Install gems
RUN bundle config set --local without 'development test' && \
    bundle install --jobs 2 --retry 3

# Precompile
RUN bundle exec rails assets:precompile 2>/dev/null || true

EXPOSE 3001
CMD ["bundle", "exec", "rails", "s", "-p", "3001", "-b", "0.0.0.0"]
