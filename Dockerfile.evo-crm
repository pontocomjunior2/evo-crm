# Evo CRM - Production Dockerfile (wrapper)
# Uses evo-ai-crm-community/docker/Dockerfile with adjusted COPY paths
FROM node:23-alpine AS node
FROM ruby:3.4.4-alpine3.21 AS pre-builder

ARG NODE_VERSION="23.7.0"
ARG PNPM_VERSION="10.2.0"
ARG BUNDLE_WITHOUT="development:test"
ARG RAILS_SERVE_STATIC_FILES=true
ARG RAILS_ENV=production
ARG CACHEBUST=5

ENV NODE_VERSION=${NODE_VERSION}
ENV PNPM_VERSION=${PNPM_VERSION}
ENV BUNDLE_WITHOUT ${BUNDLE_WITHOUT}
ENV RAILS_SERVE_STATIC_FILES ${RAILS_SERVE_STATIC_FILES}
ENV RAILS_ENV ${RAILS_ENV}
ENV BUNDLER_VERSION=2.5.11
ENV NODE_OPTIONS="--max-old-space-size=4096 --openssl-legacy-provider"
ENV BUNDLE_PATH="/gems"

RUN apk update && apk add --no-cache \
  openssl tar build-base tzdata postgresql-dev postgresql-client git curl xz \
  && mkdir -p /var/app \
  && gem install bundler -v "${BUNDLER_VERSION}"

COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
  && ln -s /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

RUN npm install -g pnpm@${PNPM_VERSION}
ENV PNPM_HOME="/root/.local/share/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

WORKDIR /app

# Copy from evo-ai-crm-community directory
COPY evo-ai-crm-community/Gemfile evo-ai-crm-community/Gemfile.lock ./
COPY evo-ai-crm-community/spec/support/extension_consumer_stub spec/support/extension_consumer_stub

RUN apk update && apk add --no-cache build-base musl ruby-full ruby-dev gcc make musl-dev openssl openssl-dev g++ linux-headers xz vips
RUN bundle config set --local force_ruby_platform true

RUN if [ "$RAILS_ENV" = "production" ]; then \
  bundle config set without 'development test extension_consumer_stub' && bundle install -j 2 -r 3; \
  else bundle install -j 2 -r 3; \
  fi

COPY evo-ai-crm-community/package.json evo-ai-crm-community/pnpm-lock.yaml ./
RUN pnpm i

COPY evo-ai-crm-community/ /app

RUN mkdir -p /app/log
RUN if [ "$RAILS_ENV" = "production" ]; then \
  find spec -mindepth 1 -maxdepth 1 ! -name support -exec rm -rf {} + && \
  find spec/support -mindepth 1 -maxdepth 1 ! -name extension_consumer_stub -exec rm -rf {} + && \
  rm -rf node_modules tmp/cache; \
  fi

ARG GIT_SHA="unknown"
RUN echo "${GIT_SHA}" > /app/.git_sha

RUN rm -rf /gems/ruby/3.4.0/cache/*.gem \
  && find /gems/ruby/3.4.0/gems/ \( -name "*.c" -o -name "*.o" \) -delete

# Final stage
FROM ruby:3.4.4-alpine3.21
ARG BUNDLE_WITHOUT="development:test"
ARG RAILS_SERVE_STATIC_FILES=true
ARG RAILS_ENV=production
ARG EXECJS_RUNTIME="Disabled"

ENV BUNDLE_WITHOUT ${BUNDLE_WITHOUT}
ENV RAILS_SERVE_STATIC_FILES ${RAILS_SERVE_STATIC_FILES}
ENV RAILS_ENV ${RAILS_ENV}
ENV BUNDLE_PATH="/gems"
ENV BUNDLER_VERSION=2.5.11
ENV BUNDLE_FORCE_RUBY_PLATFORM=1
ENV EXECJS_RUNTIME ${EXECJS_RUNTIME}

RUN apk update && apk add --no-cache \
  build-base openssl tzdata postgresql-client imagemagick git vips dos2unix ffmpeg \
  && gem install bundler -v "${BUNDLER_VERSION}"

COPY --from=node /usr/local/bin/node /usr/local/bin/
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules

COPY --from=pre-builder /gems/ /gems/
COPY --from=pre-builder /app /app
COPY --from=pre-builder /app/.git_sha /app/.git_sha

RUN dos2unix /app/docker/entrypoints/*.sh 2>/dev/null || true \
  && chmod +x /app/docker/entrypoints/*.sh 2>/dev/null || true

WORKDIR /app
EXPOSE 3000
