# Evo Bot Runtime - Production Dockerfile (wrapper)
FROM golang:1.24-alpine AS builder

WORKDIR /app

ARG CACHEBUST=5

COPY evo-bot-runtime/go.mod evo-bot-runtime/go.sum ./
RUN go mod download

COPY evo-bot-runtime/ ./
RUN go build -o bin/evo-bot-runtime ./cmd/server

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /app/bin/evo-bot-runtime .

EXPOSE 8080
CMD ["./evo-bot-runtime"]
