# =============================================================================
# Evo CRM Community — Production Environment Template
# =============================================================================
# Copie este arquivo para .env na VPS
# cp .env.production.example .env
# =============================================================================

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=evo_crm_prod
POSTGRES_PASSWORD=SUA_SENHA_FORTE_AQUI
POSTGRES_DATABASE=evo_community

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://:SUA_SENHA_REDIS@redis:6379
REDIS_PASSWORD=SUA_SENHA_REDIS

# =============================================================================
# SHARED SECRETS (GERE NOVAS SENHAS!)
# =============================================================================
SECRET_KEY_BASE=GERE_UMA_CHAVE_DE_64_BYTES_BASE64
JWT_SECRET_KEY=GERE_UMA_CHAVE_DE_64_BYTES_BASE64
ENCRYPTION_KEY=GERE_UMA_CHAVE_DE_32_BYTES_BASE64
EVOAI_CRM_API_TOKEN=GERE_UUID

# =============================================================================
# AUTH SERVICE
# =============================================================================
RAILS_ENV=production
FRONTEND_URL=https://SEU_DOMINIO.COM
AUTH_SERVICE_URL=https://auth.SEU_DOMINIO.COM
DOORKEEPER_JWT_SECRET_KEY=GERE_UMA_CHAVE_DE_64_BYTES_BASE64
MAILER_SENDER_EMAIL=noreply@SEU_DOMINIO.COM

# SMTP - Configure com seu provedor
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=SEU_DOMINIO.COM
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-app-password

# =============================================================================
# CRM SERVICE
# =============================================================================
BACKEND_URL=https://crm.SEU_DOMINIO.COM
CORS_ORIGINS=https://SEU_DOMINIO.COM,https://app.SEU_DOMINIO.COM
DISABLE_TELEMETRY=true
ENABLE_ACCOUNT_SIGNUP=true

# =============================================================================
# CORE SERVICE
# =============================================================================
DB_HOST=postgres
DB_USER=evo_crm_prod
DB_PASSWORD=SUA_SENHA_DO_BANCO
DB_NAME=evo_community

# =============================================================================
# PROCESSOR SERVICE
# =============================================================================
POSTGRES_CONNECTION_STRING=postgresql://evo_crm_prod:SUA_SENHA@postgres:5432/evo_community
REDIS_HOST=redis

# =============================================================================
# BOT RUNTIME
# =============================================================================
BOT_RUNTIME_SECRET=GERE_UMA_CHAVE
AI_PROCESSOR_API_KEY=GERE_UMA_CHAVE

# =============================================================================
# FRONTEND
# =============================================================================
VITE_APP_ENV=production
VITE_API_URL=https://crm.SEU_DOMINIO.COM
VITE_AUTH_API_URL=https://auth.SEU_DOMINIO.COM
VITE_EVOAI_API_URL=https://api.SEU_DOMINIO.COM
VITE_AGENT_PROCESSOR_URL=https://processor.SEU_DOMINIO.COM
