# Evo Frontend - Production Dockerfile (wrapper)
FROM node:20-alpine AS builder

WORKDIR /app

ARG CACHEBUST=5
ARG VITE_API_URL=http://localhost:3000
ARG VITE_AUTH_API_URL=http://localhost:3001
ARG VITE_WS_URL=http://localhost:3000
ARG VITE_EVOAI_API_URL=http://localhost:5555
ARG VITE_AGENT_PROCESSOR_URL=http://localhost:8000
ARG APP_VERSION=dev

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_AUTH_API_URL=$VITE_AUTH_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_EVOAI_API_URL=$VITE_EVOAI_API_URL
ENV VITE_AGENT_PROCESSOR_URL=$VITE_AGENT_PROCESSOR_URL
ENV APP_VERSION=$APP_VERSION

# Copy from evo-ai-frontend-community
COPY evo-ai-frontend-community/package.json evo-ai-frontend-community/package-lock.json ./
RUN npm ci

COPY evo-ai-frontend-community/ ./
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY evo-ai-frontend-community/nginx.conf /etc/nginx/conf.d/default.conf
COPY evo-ai-frontend-community/docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
